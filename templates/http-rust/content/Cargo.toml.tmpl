[package]
name = "{{project-name | kebab_case}}"
authors = ["{{authors}}"]
description = "{{project-description}}"
version = "0.1.0"
rust-version = "1.78"
edition = "2021"

[lib]
crate-type = ["cdylib"]

[dependencies]
anyhow = "1"
spin-sdk = { version = "6", default-features = false, features = ["http", "key-value", "json", "mqtt", "mysql", "pg", "postgres4-types", "redis", "variables", "export-sdk-language"] }

[workspace]
